# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# `.env.local` ne doit JAMAIS être commité.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/connexion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/activation
# Webhook Clerk (Configure → Webhooks) : signature des événements reçus
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement : contourne la RLS, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=
