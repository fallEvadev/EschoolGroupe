# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# `.env.local` ne doit JAMAIS être commité.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/connexion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/activation
# Webhook Clerk (Configure → Webhooks) : signature des événements reçus
CLERK_WEBHOOK_SIGNING_SECRET=

# Adresse publique de l'application (lien d'activation des invitations).
# En production : l'adresse réelle, ex. https://plateforme.exemple.sn
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement : contourne la RLS, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# E-mails (Resend) : avertissement des directeurs partenaires à la publication
# d'un bilan. Serveur uniquement. Sans ces deux variables, la publication
# fonctionne et les directeurs sont prévenus dans l'application seulement.
# RESEND_FROM_EMAIL : adresse d'expédition d'un domaine vérifié chez Resend,
# ex. « E-School <bilans@exemple.sn> ».
RESEND_API_KEY=
RESEND_FROM_EMAIL=
